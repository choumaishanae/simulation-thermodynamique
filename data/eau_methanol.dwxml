      <DynamicPropertiesDescriptions>
        <Property>
          <Name>Vessel Orientation</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Vertical or Horizontal (V = 0, H = 1)"</Data>
        </Property>
        <Property>
          <Name>Operating Pressure</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Current Vessel Operating Pressure"</Data>
        </Property>
        <Property>
          <Name>Liquid Level</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Current Liquid Level"</Data>
        </Property>
        <Property>
          <Name>Get Volume from Dimensions</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Calculate volume from dimensions (Diameter, Height and Head Type)"</Data>
        </Property>
        <Property>
          <Name>Volume</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Vessel Volume (define if no dimensions set)"</Data>
        </Property>
        <Property>
          <Name>Get Height from Dimensions</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Use Height from Dimensions"</Data>
        </Property>
        <Property>
          <Name>Height</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Available height for liquid (define if no dimensions set)"</Data>
        </Property>
        <Property>
          <Name>Minimum Pressure</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Minimum dynamic pressure"</Data>
        </Property>
        <Property>
          <Name>Initialize using Inlet Stream</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Initializes the vessel content with information from the inlet stream, if the vessel content is null"</Data>
        </Property>
        <Property>
          <Name>Reset Content</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Discards the current holdup at the next run step and builds it again as on a first run (see Initialize using Inlet Stream)."</Data>
        </Property>
        <Property>
          <Name>Liquid Outlet Nozzle Elevation</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Height of the liquid outlet nozzle above the vessel bottom. When the liquid level falls below it, gas leaves through the liquid outlet (gas blow-by)"</Data>
        </Property>
        <Property>
          <Name>Gas Outlet Nozzle Elevation</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Height of the gas outlet nozzle above the vessel bottom (0 = at the top). When the liquid level reaches it, liquid leaves through the gas outlet (liquid carry-over, liquid-full blowdown)"</Data>
        </Property>
        <Property>
          <Name>Gas Outlet Transition Height</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Height band below the gas nozzle over which the gas outlet changes from all gas to all liquid, so the integration does not see a step"</Data>
        </Property>
        <Property>
          <Name>Gas Outlet Homogeneous</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"The gas outlet carries the homogeneous two-phase mixture (the bulk quality of the content) while both phases exist, instead of the phase at the nozzle. The blowdown of a pipe through a hole at its end, where the flow sweeps the liquid along"</Data>
        </Property>
        <Property>
          <Name>Gas Outlet Liquid Fraction</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Mass fraction of liquid in the gas outlet (read-only)"</Data>
        </Property>
        <Property>
          <Name>Liquid Outlet Transition Height</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Height band above the nozzle over which the liquid outlet changes from all liquid to all gas, so the integration does not see a step"</Data>
        </Property>
        <Property>
          <Name>Liquid Outlet Gas Fraction</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Mass fraction of gas in the liquid outlet stream: 0 = liquid, 1 = gas blow-by (read-only)"</Data>
        </Property>
        <Property>
          <Name>Rigorous Energy Balance (UV)</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Solve the content with an internal-energy balance and a volume-energy flash, so expansion cools it and compression heats it. Off: the legacy isothermal model (temperature only moves with external heat)"</Data>
        </Property>
        <Property>
          <Name>Split Wall (Wetted/Dry)</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Track the wetted and the dry wall as two metal segments with their own temperatures (rigorous heat balance only). Needed for a depressurization or a fire case"</Data>
        </Property>
        <Property>
          <Name>Internal Heat Transfer Factor</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Multiplier on the estimated wall-to-fluid film coefficients (natural convection). 1 = the correlation as is; use it to bracket the uncertainty of a cold blowdown (0.5 to 2)"</Data>
        </Property>
        <Property>
          <Name>Fire Case (API 521)</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Pool fire around the vessel: heat to the liquid Q = C F A^0.82 on the wetted area within 7.6 m of grade (API 521), plus the flux below on the dry wall"</Data>
        </Property>
        <Property>
          <Name>Fire Environment Factor</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"API 521 environment factor F: 1.0 bare vessel, 0.3 to 0.03 with insulation credit, 0 for earth-covered"</Data>
        </Property>
        <Property>
          <Name>Fire Adequate Drainage</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"True: adequate drainage and prompt firefighting, C = 43200 W/m2 basis. False: C = 70900"</Data>
        </Property>
        <Property>
          <Name>Fire Dry Wall Heat Flux</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Fire heat absorbed by the unwetted wall, W/m2 (0 = none). The dry metal heats up and passes heat to the vapour"</Data>
        </Property>
        <Property>
          <Name>Vessel Bottom Elevation</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Height of the vessel bottom above grade; only wetted area below 7.6 m of grade counts for the fire heat"</Data>
        </Property>
        <Property>
          <Name>Wetted Area</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Wall area in contact with liquid (read-only)"</Data>
        </Property>
        <Property>
          <Name>Fire Heat Input</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Heat from the fire absorbed by the liquid (read-only)"</Data>
        </Property>
        <Property>
          <Name>Wetted Wall Heat Transfer Coefficient</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Liquid-side film coefficient used on the wetted wall (read-only)"</Data>
        </Property>
        <Property>
          <Name>Dry Wall Heat Transfer Coefficient</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Vapour-side film coefficient used on the dry wall (read-only)"</Data>
        </Property>
        <Property>
          <Name>Wetted Wall Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Temperature of the wetted wall segment (read-only)"</Data>
        </Property>
        <Property>
          <Name>Dry Wall Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Temperature of the dry wall segment (read-only)"</Data>
        </Property>
        <Property>
          <Name>Minimum Fluid Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Lowest content temperature seen since the content was (re)initialized (read-only)"</Data>
        </Property>
        <Property>
          <Name>Minimum Wetted Wall Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Lowest wetted-wall temperature since the content was (re)initialized (read-only)"</Data>
        </Property>
        <Property>
          <Name>Minimum Dry Wall Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Lowest dry-wall temperature since the content was (re)initialized (read-only)"</Data>
        </Property>
        <Property>
          <Name>Maximum Dry Wall Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Highest dry-wall temperature since the content was (re)initialized; the fire-case metal check (read-only)"</Data>
        </Property>
      </DynamicPropertiesDescriptions>
